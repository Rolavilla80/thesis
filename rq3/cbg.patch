+        Right edge: R1 ZWJ; R2 virama/InCB=Linker (toggleable); R3 Prepend; R4 Hangul
+        L jamo; R5 odd count of Regional Indicators anywhere (a cut flag emoji).
+        Single-character tokens are always allowed (atomic assembly must stay possible)."""
+        if len(text) <= 1:
+            return False
+        g = self.grapheme_sets
+        stripped = text.lstrip()
+        if stripped:
+            c = stripped[0]
+            if c == "‍" or c in g["ext"] or c in g["spm"]:  # L1
+                return True
+            if c in g["hv"] or c in g["ht"]:  # L2
+                return True
+        last = text[-1]
+        if last == "‍":  # R1
+            return True
